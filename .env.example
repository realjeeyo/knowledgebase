# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the Nuvho Knowledge Base database
DATABASE_URL=postgresql://nuvho_kb_user:password@host:5432/nuvho_kb

# Signs the admin session JWT (lib/auth.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Falls back to an insecure dev default if unset — always set this in production.
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Enables embedding + vector ingestion from the admin dashboard.
OPENAI_API_KEY=

# Per-tier vector DB connection strings. Leave blank to disable that tier.
VECTOR_DB_DOMAIN_URL=
VECTOR_DB_INTERNAL_URL=
VECTOR_DB_CLIENT_URL=
VECTOR_DB_CONFIDENTIAL_URL=

# ── Uploads (article editor images) — lib/uploads.ts ──────────────────────────
# Maximum image size in MB (default 10).
MAX_UPLOAD_MB=10

# Where image files are stored (lib/fileStore.mjs). Postgres keeps only metadata.
#   sftp   production: plain files on nuvho-vectordb, /srv/kb-uploads/files, reached over
#          the private VPC (the App Platform app must be attached to the VPC).
#   local  development only: files under UPLOADS_DIR (default ./uploads). Refused when
#          NODE_ENV=production unless UPLOADS_LOCAL_IN_PRODUCTION=true (Docker host + volume).
# The app refuses to start with a missing or invalid setting (instrumentation.ts).
UPLOAD_STORAGE=local
UPLOADS_DIR=

# sftp settings (docs/handover/2026-11-kb-image-files.md)
SFTP_HOST=10.126.0.14
SFTP_PORT=2222
SFTP_USER=kb-files
SFTP_ROOT=/files
# Host key fingerprint of nuvho-vectordb: the SHA256:… value (a whole `ssh-keygen -lf` line is accepted)
SFTP_HOST_KEY_SHA256=
# base64 of the kb-files private key (ed25519, no passphrase). Mark it encrypted in App Platform.
SFTP_PRIVATE_KEY_B64=
# Uploads are refused when the server has less than this free (default 5 GB)
SFTP_MIN_FREE_BYTES=5368709120

# ── Sign in with Microsoft (Entra ID) — lib/microsoft.ts ──────────────────────
# Same app-registration pattern as nuvho-onboarding. Leave CLIENT_ID or TENANT_ID
# blank to hide the "Sign in with Microsoft" button. Read at runtime (no rebuild).
# In Entra, add a "Single-page application" redirect URI: https://<kb-domain>/auth/callback
# (and http://localhost:3000/auth/callback for local dev). Run scripts/006_microsoft_sso.sql first.
AZURE_CLIENT_ID=
# The tenant GUID — not "common" or "organizations"; tokens are pinned to this tenant.
AZURE_TENANT_ID=
# Optional: only allow emails at this domain, e.g. nuvho.com
AZURE_ALLOWED_DOMAIN=

# ── Feature flags — lib/flags.ts ──────────────────────────────────────────────
# Read at runtime (no rebuild). Off unless set to exactly "true".
# Article version history + restore. Switch on only after Glenn has created
# nuvho_kb.article_versions (docs/handover/2026-10-kb-db-changes-for-glenn.md).
KB_VERSIONING_ENABLED=false
